<?xml version="1.0" encoding="utf-8"?>
<!-- A pod of four around a table, which is what the app is for.
     Drawn well inside the 72dp safe zone of the 108dp adaptive canvas, so no
     launcher mask can clip a seat off. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the table -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#C9A227"
        android:strokeWidth="3.5"
        android:strokeAlpha="0.5"
        android:pathData="M32,54 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0 Z" />

    <!-- the four seats -->
    <path android:fillColor="#C9A227" android:pathData="M46,32 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
    <path android:fillColor="#C9A227" android:pathData="M68,54 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
    <path android:fillColor="#C9A227" android:pathData="M46,76 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
    <path android:fillColor="#C9A227" android:pathData="M24,54 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
</vector>
